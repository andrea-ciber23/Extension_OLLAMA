{
  "manifest_version": 3,
  "name": "Ollama Document AI",
  "version": "2.2.0",
  "description": "Analiza documentos TXT con inteligencia artificial local mediante Ollama.",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:11434/*",
    "http://localhost:11434/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ollama Document AI"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}